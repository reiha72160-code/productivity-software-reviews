    gap: 0.6rem;
    margin-bottom: 0.85rem;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pc-box li:last-child {
    margin-bottom: 0;
  }

  .pc-bullet {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .pro-bullet {
    color: var(--accent-emerald);
