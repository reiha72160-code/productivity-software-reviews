    gap: 1.25rem;
  }

  .pc-box {
    background-color: var(--bg-surface);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }

  .pros-box {
    border-top: 4px solid var(--accent-emerald);
  }

  .cons-box {
    border-top: 4px solid var(--accent-red);
  }

  .pc-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .pc-header h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pc-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pros-icon {
    background-color: #D1FAE5;
    color: #065F46;
  }

  .cons-icon {
