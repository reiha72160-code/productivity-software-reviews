    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }

  .faq-item h3 {
    margin: 0 0 0.45rem;
    font-size: 1.08rem;
    color: var(--text-primary);
  }

  .faq-item p {
    margin: 0;
    font-size: 0.98rem;
  }

  .bottom-cta-wrap {
    margin: 1.75rem 0 1rem;
  }

  .bottom-cta-btn {
    font-size: 1.05rem;
    padding: 0.85rem 1.65rem;
  }

  @media (max-width: 680px) {
    .pros-cons-grid {
