---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles, categories } from '../data/articles';
---

<BaseLayout
  title="Productivity Software Reviews"
  description="Clean, research-backed SaaS reviews and workflow comparisons for small business owners, agencies, and solo creators."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="badge hero-badge">Practical SaaS Comparisons</span>
        <h1>Choose software that saves time—not tools that create more admin work.</h1>
        <p class="hero-subtitle">
          Clear, research-backed reviews of project management, documentation, billing, and automation software evaluated for small business owners and independent creators.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">Browse Latest Reviews &rarr;</a>
          <a href="/blog/notion-vs-clickup-vs-asana-small-business" class="btn btn-secondary">
            Read Sample Review
          </a>
        </div>
        <div class="trust-pillars">
          <div class="pillar">
            <strong>&#10003; Free Plans &amp; Trials</strong>
            <span>Hands-on checks of core UI &amp; onboarding flows</span>
          </div>
          <div class="pillar">
            <strong>&#10003; Pricing &amp; Spec Audits</strong>
            <span>Detailed analysis of official plans, limits &amp; fees</span>
          </div>
          <div class="pillar">
            <strong>&#10003; Aggregated Feedback</strong>
            <span>Synthesized insights from public user reviews</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="section latest-section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Latest Software Reviews &amp; Comparisons</h2>
          <p class="section-sub">In-depth guides with clear pricing math, pros &amp; cons, and "Best For" editorial verdicts.</p>
        </div>
        <a href="/blog" class="view-all-link">View all reviews &rarr;</a>
      </div>

      <div class="articles-grid">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </div>
  </section>

  <!-- Category List Section -->
  <section class="section categories-section" id="categories">
    <div class="container">
      <div class="section-header">
        <div>
          <h2>Browse by Software Category</h2>
          <p class="section-sub">Find the right tool for your bottleneck—from client onboarding to daily task tracking.</p>
        </div>
      </div>

      <div class="categories-grid">
        {categories.map((cat) => (
          <a href={`/blog?category=${cat.slug}`} class="category-card card">
            <div class="cat-top">
              <h3>{cat.name}</h3>
              <span class="cat-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <p class="cat-desc">{cat.description}</p>
            <div class="cat-footer">
              <span class="tool-examples">Includes: {cat.toolExamples}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Editorial Promise Callout -->
  <section class="section promise-section">
    <div class="container">
      <div class="promise-box">
        <div class="promise-content">
          <h2>How Our Editorial Team Evaluates Software</h2>
          <p>
            Our reviews are based on hands-on time with free plans and trials, official documentation and pricing, and aggregated user feedback. By combining firsthand exploration of free tiers with thorough pricing analysis and community sentiment, we help small teams avoid costly software mistakes.
          </p>
        </div>
        <div class="promise-cta">
          <a href="/about" class="btn btn-secondary">Our Review Methodology</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 4.5rem 0 4rem;
  }

  .hero-copy {
    max-width: 780px;
  }

  .hero-badge {
    margin-bottom: 1.15rem;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .trust-pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .pillar strong {
    font-size: 0.92rem;
    color: var(--text-primary);
  }

  .pillar span {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .section {
    padding: 4rem 0 1rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-header h2 {
    margin: 0 0 0.35rem;
  }

  .section-sub {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .view-all-link {
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.35rem;
  }

  .category-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .cat-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .cat-top h3 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--text-primary);
  }

  .cat-arrow {
    color: var(--accent-primary);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .cat-desc {
    font-size: 0.94rem;
    color: var(--text-secondary);
    margin-bottom: 1.1rem;
    flex: 1;
  }

  .cat-footer {
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .promise-box {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .promise-content {
    max-width: 680px;
  }

  .promise-content h2 {
    margin-top: 0;
    font-size: 1.55rem;
  }

  .promise-content p {
    margin-bottom: 0;
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 3rem 0 2.5rem;
    }
    .articles-grid,
    .categories-grid {
      grid-template-columns: 1fr;
    }
    .promise-box {
      padding: 1.75rem;
    }
  }
</style>
