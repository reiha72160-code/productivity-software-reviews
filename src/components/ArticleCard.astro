---
import type { ArticleMeta } from '../data/articles';

export interface Props {
  article: ArticleMeta;
}

const { article } = Astro.props;
---

<article class="article-card card">
  <div class="card-meta">
    <a href={`/blog?category=${article.categorySlug}`} class="badge">{article.category}</a>
    <span class="read-time">{article.readTime}</span>
  </div>

  <h3 class="card-title">
    <a href={`/blog/${article.slug}`}>{article.title}</a>
  </h3>

  <p class="card-excerpt">{article.excerpt}</p>

  <div class="card-footer">
    <div class="author-date">
      <span class="author-name">By {article.author}</span>
      <span class="dot" aria-hidden="true">&middot;</span>
      <time datetime={article.updatedDate}>{article.updatedDateFormatted}</time>
    </div>
    <a href={`/blog/${article.slug}`} class="read-more">
      Read Review &rarr;
    </a>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
    gap: 0.5rem;
  }

  .read-time {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .card-title {
    margin: 0 0 0.65rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent-primary);
  }

  .card-excerpt {
    font-size: 0.96rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.84rem;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .author-date {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .author-name {
    font-weight: 500;
    color: var(--text-secondary);
  }

  .read-more {
    font-weight: 600;
    text-decoration: none;
    color: var(--accent-primary);
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>
