---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Reviews & Guides' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="trust-bar">
    <div class="container trust-bar-inner">
      <span>Independent SaaS testing for small business owners &amp; creators.</span>
      <a href="/affiliate-disclosure" class="trust-link">How we test &amp; fund our work &rarr;</a>
    </div>
  </div>
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="Productivity Software Reviews Home">
      <span class="logo-mark" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="36" height="36" rx="8" fill="#0F172A"/>
          <path d="M10 18.5L15.5 24L26 12.5" stroke="#10B981" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Productivity Software Reviews</span>
        <span class="brand-tagline">Clarity in SaaS Selection</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Primary Navigation">
      <ul>
        {navLinks.map((link) => {
          const isActive = link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
          return (
            <li>
              <a href={link.href} class:list={[{ active: isActive }]}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .trust-bar {
    background-color: var(--bg-navy);
    color: #E2E8F0;
    font-size: 0.78rem;
    padding: 0.4rem 0;
  }

  .trust-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .trust-link {
    color: #6EE7B7;
    text-decoration: none;
    font-weight: 500;
  }

  .trust-link:hover {
    color: #A7F3D0;
    text-decoration: underline;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--text-primary);
    letter-spacing: -0.015em;
  }

  .brand-tagline {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-nav li {
    margin: 0;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.35rem 0.15rem;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .site-nav a:hover,
  .site-nav a.active {
    color: var(--accent-primary);
    border-bottom-color: var(--accent-primary);
  }

  @media (max-width: 640px) {
    .trust-bar-inner {
      justify-content: center;
      text-align: center;
    }
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .site-nav ul {
      gap: 1rem;
    }
  }
</style>
