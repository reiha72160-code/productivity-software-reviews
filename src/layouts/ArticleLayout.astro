---
import BaseLayout from './BaseLayout.astro';
import BestForBox, { type Props as BestForProps } from '../components/BestForBox.astro';
import ComparisonTable, { type ComparisonRow } from '../components/ComparisonTable.astro';
import ProsConsBox from '../components/ProsConsBox.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  categorySlug: string;
  author?: string;
  publishedDate: string;
  updatedDate: string;
  updatedDateFormatted: string;
  readTime: string;
  toc?: { id: string; label: string }[];
  verdictBox?: BestForProps;
  comparisonRows?: ComparisonRow[];
  comparisonCaption?: string;
  prosCons?: {
    title?: string;
    pros: string[];
    cons: string[];
  };
}

const {
  title,
  description,
  category,
  categorySlug,
  author = 'Productivity Software Reviews Editorial Team',
  publishedDate,
  updatedDate,
  updatedDateFormatted,
  readTime,
  toc = [],
  verdictBox,
  comparisonRows,
  comparisonCaption,
  prosCons,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article">
  <article class="review-article">
    <div class="article-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog">Reviews &amp; Guides</a>
          <span aria-hidden="true">/</span>
          <a href={`/blog?category=${categorySlug}`}>{category}</a>
        </nav>

        <div class="article-header-content">
          <div class="meta-badges">
            <a href={`/blog?category=${categorySlug}`} class="badge">{category}</a>
            <span class="read-time">{readTime}</span>
            <span class="fact-checked">&#10003; Editorial Review</span>
          </div>

          <h1>{title}</h1>
          <p class="article-lead">{description}</p>

          <div class="byline-bar">
            <div class="author-block">
              <div class="author-avatar" aria-hidden="true">PSR</div>
              <div>
                <div class="author-name">By <strong>{author}</strong></div>
                <div class="date-meta">
                  Last updated <time datetime={updatedDate}>{updatedDateFormatted}</time>
                  <span class="sr-only">(Originally published {publishedDate})</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container article-layout-grid">
      <div class="article-main">
        <div class="affiliate-notice" role="note">
          <strong>Transparency Note:</strong> Productivity Software Reviews is reader-supported. When you click on links to software tools on this page, we may earn a referral fee at no extra cost to you. Read our <a href="/affiliate-disclosure">full affiliate disclosure</a>.
        </div>

        {verdictBox && <BestForBox {...verdictBox} />}

        {comparisonRows && comparisonRows.length > 0 && (
          <ComparisonTable caption={comparisonCaption} rows={comparisonRows} />
        )}

        {prosCons && (
          <ProsConsBox
            title={prosCons.title}
            pros={prosCons.pros}
            cons={prosCons.cons}
          />
        )}

        <div class="article-prose">
          <slot />
        </div>
      </div>

      <aside class="article-sidebar" aria-label="Article Navigation and Editorial Standards">
        {toc.length > 0 && (
          <div class="sidebar-card toc-card">
            <h4>In This Review</h4>
            <ol class="toc-list">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))}
            </ol>
          </div>
        )}

        <div class="sidebar-card methodology-card">
          <h4>How We Evaluate SaaS</h4>
          <p>
            Our reviews are based on hands-on time with free plans and trials, official documentation and pricing, and aggregated user feedback.
          </p>
          <ul>
            <li><strong>Free Plans &amp; Trials:</strong> Exploring core interfaces and setup flows firsthand.</li>
            <li><strong>Official Pricing &amp; Specs:</strong> Auditing seat limits, plan restrictions, and hidden add-ons.</li>
            <li><strong>Aggregated User Feedback:</strong> Synthesizing public reviews and community sentiment.</li>
          </ul>
          <a href="/about" class="methodology-link">Learn about our review process &rarr;</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .article-hero {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-color);
    padding: 2.25rem 0 2.75rem;
    margin-bottom: 2.5rem;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .article-header-content {
    max-width: 820px;
  }

  .meta-badges {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .read-time {
    font-size: 0.84rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .fact-checked {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-emerald);
    background-color: #ECFDF5;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  .article-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .byline-bar {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: var(--bg-navy);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .author-name {
    font-size: 0.94rem;
    color: var(--text-primary);
  }

  .date-meta {
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .article-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 310px;
    gap: 3rem;
    align-items: start;
  }

  .affiliate-notice {
    background-color: var(--bg-subtle);
    border-left: 3px solid var(--border-strong);
    padding: 0.85rem 1.1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    line-height: 1.5;
  }

  .article-prose :global(h2) {
    scroll-margin-top: 5.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-color);
  }

  .article-prose :global(h3) {
    scroll-margin-top: 5.5rem;
  }

  .article-prose :global(blockquote) {
    margin: 1.75rem 0;
    padding: 1rem 1.35rem;
    background-color: var(--bg-surface);
    border-left: 4px solid var(--accent-primary);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--text-primary);
  }

  .article-sidebar {
    position: sticky;
    top: 5.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.35rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-card h4 {
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-color);
  }

  .toc-list {
    margin: 0;
    padding-left: 1.15rem;
  }

  .toc-list li {
    margin-bottom: 0.55rem;
    font-size: 0.9rem;
  }

  .toc-list a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .toc-list a:hover {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  .methodology-card p {
    font-size: 0.88rem;
    margin-bottom: 0.75rem;
  }

  .methodology-card ul {
    padding-left: 1.1rem;
    margin-bottom: 0.9rem;
  }

  .methodology-card li {
    font-size: 0.84rem;
    margin-bottom: 0.45rem;
  }

  .methodology-link {
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .article-layout-grid {
      grid-template-columns: 1fr;
    }

    .article-sidebar {
      position: static;
    }
  }
</style>
